# =========================================================
# Supabase — 인증·관심종목·사용량 저장에 사용
# 프로젝트 설정 → API 에서 가져옵니다.
# =========================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key — 서버 전용입니다. 절대 브라우저에 노출하지 마세요.
# 외부 API 캐시(api_cache) / 스냅샷(stock_data_snapshots) 쓰기에 사용됩니다.
# 비워두면 in-memory 캐시로 fallback 합니다.
SUPABASE_SERVICE_ROLE_KEY=

# =========================================================
# 외부 데이터 API (1단계 C)
# 비워두면 목업 데이터로 fallback 합니다 — 사이트는 정상 동작합니다.
# =========================================================

# OpenDART (한국 공시·재무) — https://opendart.fss.or.kr/
OPEN_DART_API_KEY=

# SEC EDGAR (미국 공시·재무) — 반드시 앱 이름 + 연락 가능한 이메일 형식
# 예: StockReport/0.1 contact@example.com
SEC_USER_AGENT=StockReport/0.1 contact@example.com

# 뉴스 공급자 어댑터 — mock | newsapi | brave | gnews
NEWS_PROVIDER=mock
NEWS_API_KEY=
BRAVE_SEARCH_API_KEY=
GNEWS_API_KEY=

# 실제 외부 API 사용 마스터 스위치 (true | false)
# false면 어떤 키가 있어도 목업 데이터만 사용합니다.
ENABLE_REAL_DATA=false

# =========================================================
# AI 요약 (1단계 D)
# 비워두거나 AI_SUMMARY_ENABLED=false면 mock/fallback 요약 사용.
# =========================================================

# 현재 지원: openai | mock
AI_PROVIDER=openai

# OpenAI API key (서버 전용. 절대 브라우저로 보내지 마세요)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# false면 키가 있어도 AI 호출 안 함
AI_SUMMARY_ENABLED=false

# AI에 넣을 입력 데이터 최대 길이
AI_MAX_INPUT_CHARS=12000

# AI 요약 캐시 TTL (시간)
AI_CACHE_TTL_HOURS=24
